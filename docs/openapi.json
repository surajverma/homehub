            "description": "Not found, or the tool is switched off in config.yml.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "reminders_add",
        "summary": "Add a reminder",
        "description": "Add a one-off reminder (recurring reminders are set up in HomeHub).",
        "tags": [
          "Reminders"
        ],
        "x-homehub-tool": "reminders",
        "x-homehub-level": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "What to remember."
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "description": "The day, YYYY-MM-DD."
                  },
                  "time": {
                    "type": "string",
                    "format": "time",
                    "description": "Optional time, HH:MM (24-hour). Without it the reminder lasts all day."
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000,
                    "description": "Optional details."
                  },
                  "category": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "Optional category key from config.yml (reminders > categories), for example health."
                  },
                  "by": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "The family member this change is made for: the name of the person who asked. Only accepted when the token may act as family members. Without it the token name is used."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "title",
                  "date"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The result as JSON. Changes include a short \"summary\" sentence to confirm back.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (unknown field, wrong type, bad date, ...).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token has no access to this tool or level, or may not act as that person.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the tool is switched off in config.yml.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
