                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/presence/{name}": {
      "put": {
        "operationId": "presence_set",
        "summary": "Set who is home",
        "description": "Set a family member Home or Away, for example from a Home Assistant zone automation. The name is matched without regard to case. Needs a token that can act as family members.",
        "tags": [
          "Who is home"
        ],
        "x-homehub-tool": "presence",
        "x-homehub-level": "write",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The family member, for example Priya.",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "home",
                      "away"
                    ],
                    "description": "home or away (any case)."
                  },
                  "by": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "The family member this change is made for: the name of the person who asked. Only accepted when the token may act as family members. Without it the token name is used."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result as JSON. Changes include a short \"summary\" sentence to confirm back.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (unknown field, wrong type, bad date, ...).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token has no access to this tool or level, or may not act as that person.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the tool is switched off in config.yml.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
