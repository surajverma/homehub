{
  "openapi": "3.1.0",
  "info": {
    "title": "HomeHub API",
    "version": "1",
    "description": "Token-protected JSON API for HomeHub. Send the token as \"Authorization: Bearer <token>\". Create tokens in HomeHub under Admin tools, API access, or with \"flask api-token create\". See docs/api.md for examples."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Overview"
    },
    {
      "name": "Who is home"
    },
    {
      "name": "Personal status"
    },
    {
      "name": "Notice board"
    },
    {
      "name": "Reminders"
    },
    {
      "name": "Shopping list"
    },
    {
      "name": "Chores"
    },
    {
      "name": "Notes"
    },
    {
      "name": "Recipes"
    },
    {
      "name": "Expiry tracker"
    },
    {
      "name": "Expenses"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "homehub_overview",
        "summary": "Overview",
        "description": "What this token can do: its name, whether it may act as family members or delete, the tools it can use with their level (read or write), and the family members it can act as. Call this first.",
        "tags": [
          "Overview"
        ],
        "x-homehub-tool": null,
        "x-homehub-level": "read",
        "responses": {
          "200": {
            "description": "The result as JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (unknown field, wrong type, bad date, ...).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token has no access to this tool or level, or may not act as that person.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the tool is switched off in config.yml.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document",
        "description": "The OpenAPI description of the operations this token can use.",
        "tags": [
          "Overview"
        ],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp",
        "summary": "MCP endpoint",
        "description": "Model Context Protocol server (Streamable HTTP, JSON responses, no sessions) for AI agents. Offers the same operations as MCP tools, with the same token and permissions.",
        "tags": [
          "Overview"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Notification accepted."
          },
          "401": {
            "description": "Missing, wrong or revoked token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A HomeHub API token (hh_...)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code: unauthorized, forbidden, not_found, bad_request, conflict, too_large, method_not_allowed, server_error."
          },
          "message": {
            "type": "string",
            "description": "What went wrong, in the household language."
          }
        },
        "required": [
          "error",
          "message"
        ]
      }
    }
  }
}
