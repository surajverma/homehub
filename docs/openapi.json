    "/reminders": {
      "get": {
        "operationId": "reminders_list",
        "summary": "Reminders",
        "description": "Reminders for today (the default), this week (Monday to Sunday, as the calendar shows it), or a range of at most 62 days. Dates of recurring reminders are included (they have a negative id and a recurring_id); reminders in the trash are not.",
        "tags": [
          "Reminders"
        ],
        "x-homehub-tool": "reminders",
        "x-homehub-level": "read",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "today or week. Leave out when sending from and to.",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "week"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First day, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last day, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The result as JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
