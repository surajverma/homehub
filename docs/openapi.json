    "/statuses/me": {
      "put": {
        "operationId": "statuses_set",
        "summary": "Set my status",
        "description": "Set or clear the personal status of the family member named in \"by\" (required). An empty text clears it.",
        "tags": [
          "Personal status"
        ],
        "x-homehub-tool": "statuses",
        "x-homehub-level": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "The status, for example \"Working from home\". Empty clears it."
                  },
                  "by": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "The family member this change is made for: the name of the person who asked. Only accepted when the token may act as family members. Without it the token name is used."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "text",
                  "by"
                ]
              }
            }
